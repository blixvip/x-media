# The main media archive needs NO environment file, login, cookies, or API key.
# These optional settings do not change its anonymous collector.

# Dashboard: blank uses demo data; a token selects the official X API provider.
# Also selects the official provider for legacy POST /api/media-archive.
# Never expose credentials through NEXT_PUBLIC_* variables.
X_BEARER_TOKEN=

# Tweets page: free public collection and local archive import need no credentials.
# Previously saved X_POSTS_BEARER_TOKEN values are unused by /posts.

# Official-compatible base. HTTPS required except for loopback development.
X_API_BASE_URL=https://api.x.com/2

# Dashboard storage and limits, resolved from the project root.
TRACKER_DATA_FILE=.data/tracker-state.json
MAX_TRACKED_ACCOUNTS=25
DATA_RETENTION_DAYS=30

# Required only for the optional GET /api/cron/sync endpoint.
CRON_SECRET=

# Legacy synchronous API only. These do NOT affect the main media archive.
# Both cookies are required together if choosing this optional legacy provider.
X_SCRAPER_AUTH_TOKEN=
X_SCRAPER_CT0=
X_SCRAPER_MAX_POSTS=10000
X_SCRAPER_TIMEOUT_MS=90000

# Reddit collector: defaults to .data/reddit and refreshes every three minutes.
# MEME_DATA_DIR=C:/private/x-media-reddit
MEME_OFFLINE=0
# Optional public-image analysis, off until enabled in Reddit Settings.
OPENAI_API_KEY=
# Optional redirect for old Reddit app bookmarks. Windows launcher sets this.
# MEME_LEGACY_REDIRECT_PORT=8321
# X_MEDIA_URL=http://127.0.0.1:4330

# Optional X Master account services (private .env.local; never commit credentials).
SUPABASE_URL=
SUPABASE_ANON_KEY=
X_MASTER_AUTH_SECRET=
X_MASTER_ALLOWED_EMAILS=
# X_REFERENCE_LOCAL_DB_PATH=C:/private/x-master/master.sqlite
# X_MEDIA_SERVICE_URL=
# X_MEDIA_SERVICE_TOKEN=
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_OAUTH_SESSION_SECRET=

# Disable account-free library access on the loopback app (enabled by default).
# X_MEDIA_LOCAL_WORKSPACE=0
